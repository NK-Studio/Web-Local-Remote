<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="wlr-root">
        <ui:VisualElement class="header">
            <ui:VisualElement class="header-text">
                <ui:Label name="header-title" text="Web Remote" class="header-title"/>
                <ui:Label text="by NK Studio" class="header-subtitle"/>
            </ui:VisualElement>
            <ui:VisualElement class="status-box">
                <ui:VisualElement name="status-dot" class="status-dot status-offline"/>
                <ui:Label name="status-text" text="Offline" class="status-text"/>
            </ui:VisualElement>
            <ui:Button name="help-btn" text="?" class="icon-button" tooltip="사용법 (Documentation)"/>
        </ui:VisualElement>

        <ui:VisualElement name="missing-module-view" class="missing-module-view" style="display: none;">
            <ui:Label text="WebGL 모듈이 필요합니다!" class="missing-module-title"/>
            <ui:Label text="Unity Hub에서 현재 버전에 대한 WebGL Build Support를 설치해주세요." class="missing-module-desc"/>
        </ui:VisualElement>

        <ui:VisualElement name="main-content-view" class="main-content">
            <ui:VisualElement class="tab-bar">
                <ui:Button name="tab-server" text="서버" class="tab tab-selected"/>
                <ui:Button name="tab-debug" text="원격 디버그" class="tab"/>
                <ui:Button name="tab-settings" text="설정" class="tab"/>
            </ui:VisualElement>

            <!-- 서버 -->
            <ui:VisualElement name="page-server" class="page">
                <ui:VisualElement class="card">
                    <ui:Label text="빌드 폴더" class="card-title"/>
                    <ui:VisualElement class="field-row">
                        <ui:TextField name="build-path" readonly="true" class="path-field" tooltip="WebGL 빌드 폴더 (index.html이 있는 곳)"/>
                        <ui:Button text="Browse" name="select-path-btn" class="secondary-btn"/>
                    </ui:VisualElement>
                    <ui:Button name="toggle-server-btn" text="▶ Run" class="ButtonStyle run-button"/>
                </ui:VisualElement>
                <ui:VisualElement name="qr-container" class="card card-fill qr-card">
                    <ui:VisualElement class="segmented">
                        <ui:Button name="qr-app-btn" text="빌드 열기" class="segment segment-selected" tooltip="폰으로 스캔해 빌드를 엽니다."/>
                        <ui:Button name="qr-setup-btn" text="기기 설정 · 인증서" class="segment" tooltip="처음 한 번: 폰으로 스캔해 루트 CA를 설치합니다."/>
                    </ui:VisualElement>
                    <ui:VisualElement class="qr-center">
                        <ui:VisualElement name="qr-box" class="qr-box">
                            <ui:Image name="qr-image" class="qr-image"/>
                            <ui:Label name="qr-placeholder" text="서버를 실행하면&#10;접속 QR이 표시됩니다" class="qr-placeholder"/>
                        </ui:VisualElement>
                        <ui:Label name="url-label" text="" selectable="true" class="url-text"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 원격 디버그 -->
            <ui:VisualElement name="page-debug" class="page" style="display: none;">
                <ui:VisualElement class="card">
                    <ui:Label text="원격 콘솔" class="card-title"/>
                    <ui:Label text="폰의 로그·오류를 PC에서 보고 JS를 실행합니다. Android와 iPhone 모두 케이블 없이 동작합니다." class="card-desc"/>
                    <ui:VisualElement class="field-row">
                        <ui:Button name="open-console-btn" text="원격 콘솔 열기" class="secondary-btn grow-btn first"/>
                        <ui:Toggle name="mirror-toggle" label="Unity 콘솔로 받기" class="mirror-toggle"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="card">
                    <ui:Label text="Android · USB" class="card-title"/>
                    <ui:Label text="adb reverse로 폰에서 빌드를 열고 PC Chrome으로 검사합니다." class="card-desc"/>
                    <ui:VisualElement class="field-row">
                        <ui:Button name="adb-open-btn" text="폰에서 열기" class="secondary-btn grow-btn first" tooltip="adb reverse로 폰의 localhost:포트를 이 PC로 연결하고 폰 브라우저에서 빌드를 엽니다."/>
                        <ui:Button name="chrome-inspect-btn" text="Chrome DevTools" class="secondary-btn grow-btn" tooltip="PC Chrome의 chrome://inspect를 엽니다."/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="card">
                    <ui:Label text="iPhone · USB (Mac)" class="card-title"/>
                    <ui:Label text="Mac Safari의 개발자 메뉴로 iPhone 페이지를 검사합니다." class="card-desc"/>
                    <ui:VisualElement class="field-row">
                        <ui:Button name="safari-inspect-btn" text="Safari 웹 속성 보기" class="secondary-btn grow-btn first"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="card card-fill">
                    <ui:Label text="결과" class="card-title"/>
                    <ui:ScrollView class="result-scroll">
                        <ui:Label name="remote-status-label" text="" selectable="true" class="result-text"/>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 설정 -->
            <ui:VisualElement name="page-settings" class="page" style="display: none;">
                <ui:VisualElement class="card">
                    <ui:Label text="서버" class="card-title"/>
                    <ui:VisualElement class="field-row">
                        <ui:Label text="포트" class="field-label"/>
                        <uie:IntegerField name="port-field" value="8080" is-delayed="true" class="path-field"/>
                        <ui:Button text="Reset" name="reset-port-btn" class="secondary-btn" tooltip="기본 포트(8080)로 되돌리기"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="card">
                    <ui:Label text="HTTPS 인증서" class="card-title"/>
                    <ui:VisualElement class="field-row">
                        <ui:Label text="CERT" class="field-label"/>
                        <ui:TextField name="cert-path-field" readonly="true" class="path-field"/>
                        <ui:Button text="…" name="select-cert-btn" class="secondary-btn square-btn"/>
                        <ui:Button text="×" name="clear-cert-btn" class="secondary-btn square-btn danger-btn"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="field-row">
                        <ui:Label text="KEY" class="field-label"/>
                        <ui:TextField name="key-path-field" readonly="true" class="path-field"/>
                        <ui:Button text="…" name="select-key-btn" class="secondary-btn square-btn"/>
                        <ui:Button text="×" name="clear-key-btn" class="secondary-btn square-btn danger-btn"/>
                    </ui:VisualElement>
                    <ui:Label name="ssl-warning-label" text="Certificate files not found! Falling back to HTTP." class="ssl-warning" style="display: none;"/>
                    <ui:VisualElement class="field-row">
                        <ui:Button text="로컬 CA + 인증서 생성" name="generate-cert-btn" class="secondary-btn grow-btn first primary-btn" tooltip=".cert/에 루트 CA(처음 한 번)와 현재 IP용 서버 인증서를 만듭니다."/>
                        <ui:Button text="이 PC에서 CA 신뢰" name="trust-ca-btn" class="secondary-btn grow-btn" tooltip="이 PC 브라우저에서 원격 콘솔(https://localhost)을 경고 없이 엽니다."/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="card card-fill">
                    <ui:Label text="인증서 상태" class="card-title"/>
                    <ui:Label name="ca-status-label" text="" selectable="true" class="info-text"/>
                    <ui:Label name="help-box-security" text="Security: Private certificates in .cert/ should be added to .gitignore." class="card-desc"/>
                    <ui:Label name="help-box-performance" text="Performance: GZip/Brotli compression requires HTTPS to function correctly on most mobile browsers." class="card-desc"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
